# Semua variabel di sini hanya dipakai di server — tidak ada yang dikirim ke browser.

# Supabase (SAMA dengan yang dipakai semua template): Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Penandatangan cookie sesi admin (min. 32 karakter). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Penandatangan tautan pratinjau draft (min. 32 karakter).
# Nilai ini HARUS SAMA dengan PREVIEW_SECRET di setiap template.
PREVIEW_SECRET=

# Subdomain per undangan diatur di panel admin → menu "Domain" (disimpan di database),
# bukan di sini. Lihat docs/SUBDOMAIN.md.
