# Semua variabel di sini hanya dipakai di server — tidak ada yang dikirim ke browser.

# Supabase yang SAMA dengan admin: Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kode template ini — harus sama dengan kolom "Kode" saat mendaftarkan template di admin.
TEMPLATE_CODE=kudo-6

# Penandatangan tautan pratinjau draft (min. 32 karakter) — HARUS SAMA dengan PREVIEW_SECRET di admin.
PREVIEW_SECRET=

# Rahasia bersama dengan gateway subdomain (min. 32 karakter) — SAMA dengan
# GATEWAY_SECRET di gateway/. Kosongkan bila tidak memakai subdomain.
GATEWAY_SECRET=
