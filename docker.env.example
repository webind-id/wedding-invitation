# Salin menjadi .env (di folder yang sama dengan docker-compose.yml), lalu isi.
#   cp docker.env.example .env
# .env sudah di-.gitignore — JANGAN di-commit.
# Buat nilai acak (min. 32 karakter):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   atau: openssl rand -base64 32

# Supabase yang sama untuk admin & semua template: Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Hanya admin: penandatangan cookie sesi.
SESSION_SECRET=

# Admin & semua template: penandatangan tautan pratinjau draft.
PREVIEW_SECRET=

# Semua template: HARUS SAMA dengan `wrangler secret put GATEWAY_SECRET` di gateway/.
GATEWAY_SECRET=

# Connector Cloudflare Tunnel dijalankan di luar Compose ini dan harus terhubung
# ke network Docker eksternal `cloudflare_net`.

# Docker Hub namespace yang dipakai workflow GitHub Actions.
# Hapus baris ini jika image berada di namespace `kudostack`.
IMAGE_NAMESPACE=kudostack
# Tag image yang dijalankan server.
IMAGE_TAG=latest
